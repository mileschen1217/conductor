{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "task-result",
  "x_provenance": {
    "source_repo": "touchstone",
    "source_paths": [
      "skills/epic-driven-roadmap/templates/task-result.json",
      "skills/epic-driven-roadmap/references/tasks.md (§ Task status vocabulary)",
      "skills/epic-driven-roadmap/templates/task-contract.md (behavioral contract rule 3)"
    ],
    "source_commit": "627524633d2215fa139291109345d4196c4fd00b",
    "schema_version": "1.1",
    "vendored_date": "2026-07-10",
    "modifications": [
      "template instance transcribed into JSON Schema form (fields, types, closed value sets)",
      "runtime kept as free string: source enum names concrete harnesses, which violates this repo's neutrality invariant (I1); harness binding lives in adapters/",
      "status value set transcribed from the two source_paths named above (single home here after vendoring)",
      "source_repo recorded by repo identity, not local disk path: the checkout path contains a term this repo's neutrality scan bans; the full local path is recorded in the vendor commit message (outside scan scope)",
      "2026-07-11 (v2 spec REQ-3): optional judgment_events added — additive, schema_version stays 1.1; worker advisor-use disclosure surface"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "role", "runtime", "status",
    "scope_change_request", "summary", "files_changed", "commands_run",
    "tests_passed", "risks", "handoff_notes", "observations",
    "started_at", "completed_at", "duration_ms", "fallback_reason"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.1"] },
    "task_id": { "type": "string" },
    "role": { "type": "string" },
    "runtime": { "type": "string" },
    "status": { "type": "string", "enum": ["pending", "in-flight", "blocked", "done", "failed", "needs-scope-expansion"] },
    "scope_change_request": { "type": ["object", "null"] },
    "summary": { "type": "string" },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "commands_run": { "type": "array", "items": { "type": "string" } },
    "tests_passed": { "type": ["boolean", "null"] },
    "risks": { "type": "array", "items": { "type": "string" } },
    "handoff_notes": { "type": "string" },
    "observations": { "type": "string" },
    "started_at": { "type": "string" },
    "completed_at": { "type": "string" },
    "duration_ms": { "type": "integer" },
    "fallback_reason": { "type": ["string", "null"] },
    "judgment_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "decision_type", "summary"],
        "properties": {
          "type": { "type": "string", "enum": ["advisor_call"] },
          "decision_type": { "type": "string", "enum": ["tactical", "contract-interpretation", "acceptance-interpretation"] },
          "summary": { "type": "string" }
        }
      }
    }
  }
}
